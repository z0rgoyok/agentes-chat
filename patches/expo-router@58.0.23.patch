+  // agentes: the touched view or one above it, up to the view the menu is on, marked "own-hold" (React Native's
+  // `testID`, the view's accessibilityIdentifier on iOS).
+  private func startsOnOwnHold(_ interaction: UIContextMenuInteraction, at location: CGPoint) -> Bool {
+    guard let host = interaction.view else {
+      return false
+    }
+    var view = host.hitTest(location, with: nil)
+    while let current = view, current !== host {
+      if current.accessibilityIdentifier == "own-hold" {
+        return true
+      }
+      view = current.superview
+    }
+    return false
+  }
