{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentes.chat",
  "version": "0.8.5",
  "identifier": "chat.agentes.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "agentes.chat",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "welcome",
        "create": false,
        "url": "index.html",
        "title": "agentes.chat",
        "width": 720,
        "height": 600,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "prefs",
        "create": false,
        "url": "index.html",
        "title": "agentes.chat",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agenteschat"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCREU5NDA5OTVGNEMwNUEKUldSYXdQU1ZDWlRlVzU1RVZjUno1Y1B3cS9UODJQcFd5WkJnbGNsYW5TcUc4OWpZbzRJeHU2K20K",
      "endpoints": [
        "https://app.agentes.chat/api/desktop/update?target={{target}}&arch={{arch}}&current={{current_version}}&bundle={{bundle_type}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "agentes.chat",
    "copyright": "Copyright © 2026 Codari Global, LLC",
    "license": "AGPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/agentes-runner", "binaries/agent-browser"],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "licenses/agent-browser/*": "licenses/agent-browser/",
      "licenses/bun/*": "licenses/bun/"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
